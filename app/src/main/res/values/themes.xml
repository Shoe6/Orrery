<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal window theme for a full-Compose app.
        NoActionBar prevents the system action bar from appearing alongside Compose top bars.
        The dark window background suppresses the white flash during cold start.
    -->
    <style name="Theme.Orerry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
